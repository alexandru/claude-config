{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  // The main thread runs as this agent; `claude --agent Solo` overrides it.
  "agent": "Orchestrator",
  "env": {
    "CLAUDE_CODE_MAX_SUBAGENT_SPAWN_DEPTH": "16",
  },
  "permissions": {
    "defaultMode": "auto",
    "additionalDirectories": [
      "~/.agents/librarian",
      "~/.agents/sessions/claude",
    ],
    "deny": [
      // Built-in subagents duplicate the configured roles.
      "Agent(Explore)",
      "Agent(Plan)",
      "Agent(general-purpose)",
      "Agent(claude)",
      "Agent(claude-code-guide)",
      "Edit(~/.agents/skills/**)",
      "Edit(~/.claude/skills/**)",
    ],
  },
}
