{
  // ----------------------------------------------------------------------------------
  // The default preset
  "default": {
    "extends": ["p-opus"],
  },
  // ----------------------------------------------------------------------------------
  // `model` and `effortLevel` apply to the main agents (Orchestrator / Solo).
  // `agents` entries set the frontmatter of agents/<name>.md, generated from
  // agent-templates/<name>.md.
  "p-opus": {
    "model": "claude-opus-5-5",
    "effortLevel": "high",
    "agents": {
      "Junior": {
        "model": "claude-haiku-5-5",
        "effort": "high",
      },
    },
  },
  "p-fable": {
    "model": "claude-fable-5-1",
    "effortLevel": "medium",
    "agents": {
      "Junior": {
        "model": "claude-haiku-5-5",
        "effort": "high",
      },
    },
  },
  "p-sonnet": {
    "model": "claude-sonnet-5-5",
    "effortLevel": "high",
    "agents": {
      "Junior": {
        "model": "claude-haiku-5-5",
        "effort": "high",
      },
    },
  },
}
